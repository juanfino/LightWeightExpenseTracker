# Required
TELEGRAM_TOKEN=your-telegram-bot-token
USERS_JSON=[{"telegram_id":"123456789","name":"Juampi"},{"telegram_id":"987654321","name":"Caro"}]

# Optional — enables ticket photo OCR, voice/dollar extraction, and the natural-language intent layer
ANTHROPIC_API_KEY=

# Optional — enables voice message transcription (Whisper)
OPENAI_API_KEY=

# Optional — path to SQLite database (default: /data/gastos.db)
DB_PATH=/data/gastos.db

# Optional — dashboard port (default: 5000)
DASHBOARD_PORT=
